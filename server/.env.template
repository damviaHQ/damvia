# Damvia server configuration. Copy to .env and fill in.
# Full reference: docs/reference/environment-variables.md

# --- Application ---
APP_NAME=Damvia - Open Source Digital Asset Management
# Host-only: show the uploaded client logo in admin; false always uses Damvia.
# ADMIN-CLIENT-LOGO is also accepted and takes precedence if both are set.
ADMIN_CLIENT_LOGO=false
# public URL of the client (used in emails and redirects)
APP_URL=http://localhost:5173
# public URL of this server (used in download links)
API_URL=http://localhost:3000
# Required at startup: random signing secret of at least 32 bytes (openssl rand -hex 32)
APP_SECRET=
PORT=3000
# production in deployments
NODE_ENV=development
# run the pg-boss worker in this process (npm run dev sets it)
ENABLE_WORKER=true
# true selects magic-link login; does not erase old passwords
ENABLE_PASSWORD_LESS_AUTH=false
# storage plan in decimal units (1500GB, 1.5TB); empty means no limit and no alerts
STORAGE_QUOTA=
# Skip the deletion pass of a cloud sync when more than this share of a source is absent from its listing (0-100, default 20)
ASSET_SYNC_MAX_DELETION_PERCENT=
# path whose disk is monitored; / sees the host disk from inside the container
STORAGE_DISK_PATH=/
# who runs the server, comma separated: receives critical disk alerts and sees the disk on the dashboard
SERVER_ALERT_EMAILS=
# days of activity events kept for Insights; 0 keeps them forever
ANALYTICS_RETENTION_DAYS=365
# false stops the one-line log per HTTP response
REQUEST_LOG=true
# searches kept for Insights: named, anonymous (terms without the searcher) or off
ANALYTICS_SEARCH_MODE=named
# organisation responsible for personal data and its privacy contact, shown on the privacy page
PRIVACY_CONTROLLER=
PRIVACY_CONTACT=
# days before a licence ends on which admins are emailed; empty sends none
LICENSE_EXPIRY_NOTICE_DAYS=30,7,1
# days of audit log entries kept; 0 keeps them forever
AUDIT_RETENTION_DAYS=730
# false stops recording client address and browser in the audit log
AUDIT_LOG_IP=true
# true also writes every audit entry to the server log (for a SIEM)
AUDIT_LOG_STREAM=false

# --- Sign-in and sessions ---
# a session unused this many hours ends
SESSION_IDLE_HOURS=12
# a session ends this many hours after sign-in (720 = 30 days)
SESSION_MAX_HOURS=720
# lax when client and API share a domain; none (HTTPS only) for unrelated domains
SESSION_COOKIE_SAMESITE=lax
# roles that must use two-step verification, comma separated (admin,manager)
MFA_REQUIRED_ROLES=
# check new passwords against Have I Been Pwned (k-anonymity); false without internet
PASSWORD_BREACH_CHECK=true
# reverse proxies to trust for the client address: a hop count, true, false or addresses
TRUST_PROXY=1

# --- Single sign-on (OpenID Connect), optional; see docs/integrations/single-sign-on.md ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Single sign-on
OIDC_SCOPES=openid email profile
# true only if users cannot choose their own email at the provider
OIDC_TRUST_EMAIL=false
# true creates an approved member at first sign-in
OIDC_AUTO_CREATE=false
OIDC_DEFAULT_REGION=
OIDC_GROUPS_CLAIM=
# JSON object: provider group value -> Damvia group name
OIDC_GROUP_MAP=
# true: single sign-on only, except for guests
OIDC_ONLY=false

# --- Database ---
DATABASE_URL=postgresql://dam:dam@localhost/dam

# --- Object storage (S3 / MinIO) ---
# Format: http(s)://ACCESS_KEY:SECRET_KEY@host:port/bucket (percent-encode / + @ : in keys)
MAIN_S3_URL=http://dam:damdamdamdam@localhost:9000/dam
ASSETS_S3_URL=http://dam:damdamdamdam@localhost:9000/dam-assets
# false skips the startup check that both buckets have default server-side encryption
S3_ENCRYPTION_CHECK=true

# --- Email ---
# docker-compose MailHog listens on localhost:1025
SMTP_HOST=localhost
SMTP_PORT=1025
# auth is only used when both SMTP_USER and SMTP_PASS are set
SMTP_USER=
SMTP_PASS=
# true refuses to send without STARTTLS (recommended outside the host)
SMTP_REQUIRE_TLS=false

# --- Cloud storage sync ---
# Several folders or accounts: a JSON object (raw or base64) with 'accounts' and 'sources',
# see docs/integrations/sources.md. When set, ASSET_UPDATER and the provider variables are ignored.
ASSET_SOURCES=
# Single source: 'dropbox', 'onedrive' or 'googledrive'
ASSET_UPDATER=dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
# true to sync the Dropbox Business team space instead of the member's home folder
DROPBOX_USE_TEAM_ROOT=false
# empty for the whole Dropbox, or a folder like '/Marketing/Assets' to sync one subtree
DROPBOX_ROOT_PATH=
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_USER=onedriveusername@company.com
# 'root' for the whole drive, or a closed path like 'root:/Marketing/Assets:' for one subtree
ONEDRIVE_DRIVE=root
# base64 (or raw) JSON key of the service account the folder is shared with
GOOGLE_DRIVE_SERVICE_ACCOUNT=
# id of the folder to sync, the last part of its URL
GOOGLE_DRIVE_FOLDER_ID=
# optional: a Workspace user to act as, with domain-wide delegation
GOOGLE_DRIVE_IMPERSONATE=

# --- Record linking ---
# Only read when upgrading an install that linked files with this regex: it
# becomes the File name step of every asset type without one. Matching is then
# set in Data enrichment > Link to products. New installs leave both empty.
# group 1 = record key, group 2 = record view
PRODUCT_MATCHING_REGEX=
# Only read by the same upgrade: the thumbnail view in Settings
PIM_PRODUCT_VIEW=
