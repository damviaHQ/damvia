# Damvia server configuration. Copy to .env and fill in.
# Full reference: docs/reference/environment-variables.md

# --- Application ---
APP_NAME=Damvia - Open Source Digital Asset Management
APP_URL=http://localhost:5173        # public URL of the client (used in emails and redirects)
API_URL=http://localhost:3000        # public URL of this server (used in download links)
APP_SECRET=                          # JWT signing secret; generate a long random string
PORT=3000
NODE_ENV=development                 # production in deployments
ENABLE_WORKER=true                   # run the pg-boss worker in this process (npm run dev sets it)
ENABLE_PASSWORD_LESS_AUTH=false      # true = magic-link login only, no passwords

# --- Database ---
DATABASE_URL=postgresql://dam:dam@localhost/dam

# --- Object storage (S3 / MinIO) ---
# Format: http(s)://ACCESS_KEY:SECRET_KEY@host:port/bucket
MAIN_S3_URL=http://dam:damdamdamdam@localhost:9000/dam
ASSETS_S3_URL=http://dam:damdamdamdam@localhost:9000/dam-assets

# --- Email ---
SMTP_HOST=localhost                  # docker-compose MailHog listens on localhost:1025
SMTP_PORT=1025
SMTP_USER=                           # auth is only used when both SMTP_USER and SMTP_PASS are set
SMTP_PASS=
MAILCONFIG=                          # base64 of mailconfig.json; leave empty to read server/mailconfig.json

# --- Cloud storage sync ---
ASSET_UPDATER=dropbox                # or 'onedrive'
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_USE_TEAM_ROOT=false          # true to sync the Dropbox Business team space instead of the member's home folder
ONEDRIVE_TENANT_ID=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_USER=onedriveusername@company.com
ONEDRIVE_DRIVE=root:/folder

# --- PIM linking ---
PRODUCT_MATCHING_REGEX=^(.{6}-\d{3})(?:\.(\d{2}))?   # group 1 = product key, group 2 = product view
PIM_PRODUCT_VIEW=00                  # view code used as the product thumbnail
