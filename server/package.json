{
  "name": "damvia-server",
  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "prebuild": "rm -rf dist",
    "build": "NODE_ENV=production tsc",
    "dev": "ENABLE_WORKER=true nodemon --exec ts-node src/index.ts",
    "cli": "ts-node src/cli.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "test": "npm run build && node --test --test-concurrency=1 test/*.cjs",
    "test:security": "npm run build && node --test --test-concurrency=1 test/security.cjs test/auth.cjs test/auth-invariants.cjs test/access.cjs test/catalogue-access.cjs test/record-picture-access.cjs test/audit.cjs test/privacy.cjs test/credentials.cjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@googleapis/drive": "^26.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@trpc/server": "^11.19.0",
    "archiver": "^8.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.1",
    "dropbox": "^10.46.0",
    "exif-reader": "^2.0.3",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.3",
    "libreoffice-convert": "^1.8.2",
    "liquidjs": "^10.29.0",
    "load-esm": "^1.0.3",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "nodemailer": "^10.0.10",
    "openid-client": "^6.8.8",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.2",
    "promise-parallel-throttle": "^3.5.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "typeorm": "^1.1.1",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
