{
  "name": "damvia-server",
  "scripts": {
    "start": "NODE_ENV=production node dist/index.js",
    "build": "NODE_ENV=production tsc",
    "dev": "ENABLE_WORKER=true nodemon --exec ts-node src/index.ts",
    "cli": "ts-node src/cli.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "test": "npm run build && node --test --test-concurrency=1 test/*.cjs",
    "test:security": "npm run build && node --test test/security.cjs"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@fastify/cors": "^11.3.0",
    "@googleapis/drive": "^26.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/microsoft-graph-types": "^2.43.1",
    "@trpc/server": "^11.19.0",
    "archiver": "^8.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.1",
    "dropbox": "^10.46.0",
    "fastify": "^5.12.5",
    "file-type": "^22.1.1",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.3",
    "libreoffice-convert": "^1.8.2",
    "liquidjs": "^10.29.0",
    "load-esm": "^1.0.3",
    "mime-types": "^3.0.2",
    "minio": "^8.0.7",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "pg-boss": "^10.2.0",
    "promise-parallel-throttle": "^3.5.0",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.4",
    "typeorm": "^0.3.22",
    "typeorm-naming-strategies": "^4.1.0",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.20.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
